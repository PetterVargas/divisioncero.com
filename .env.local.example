# Copia este archivo a .env.local para desarrollo local. .env.local no se versiona.

# Claves de prueba públicas de Cloudflare Turnstile: siempre validan.
# Las reales solo viven en Cloudflare: NEXT_PUBLIC_* en las variables de build del proyecto de Pages
# y CAPTCHA_SECRET_TOKEN como secreto (lo usan las Pages Functions de functions/herramientas/api).
# Para probar las Functions en local: pnpm preview (wrangler pages dev lee .dev.vars, no .env.local).
NEXT_PUBLIC_CAPTCHA_SITE_KEY=1x00000000000000000000AA
NEXT_PUBLIC_CAPTCHA_WIDGET_SIZE=normal
CAPTCHA_SECRET_TOKEN=1x0000000000000000000000000000000AA

# Opcional: fotos del Museo del Cibercrimen (https://unsplash.com/developers)
# UNSPLASH_ACCESS_KEY=
# UNSPLASH_COLLECTION_ID=BZ5AqzaA0Xs
