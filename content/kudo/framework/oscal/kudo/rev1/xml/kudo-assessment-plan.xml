   <local-definitions>
      <activity uuid="88baad88-160c-5b7c-8eec-2f85aae8ed35">
         <title>Revisión documental</title>
         <description>
            <p>Revisar políticas, procedimientos, registros y configuraciones que evidencian el control.</p>
         </description>
         <prop name="method" value="EXAMINE"/>
         <related-controls>
            <control-selection>
               <include-all/>
            </control-selection>
         </related-controls>
      </activity>
      <activity uuid="af709827-56ca-57fa-83bf-875b48002241">
         <title>Entrevista</title>
         <description>
            <p>Entrevistar a los responsables del control y a una muestra de usuarios.</p>
         </description>
         <prop name="method" value="INTERVIEW"/>
         <related-controls>
            <control-selection>
               <include-all/>
            </control-selection>
         </related-controls>
      </activity>
      <activity uuid="fd2c2ee4-dd6c-5435-9f4b-7105174742e7">
         <title>Prueba técnica</title>
         <description>
            <p>Verificar el funcionamiento del control mediante pruebas o muestreo.</p>
         </description>
         <prop name="method" value="TEST"/>
         <related-controls>
            <control-selection>
               <include-all/>
            </control-selection>
         </related-controls>
      </activity>
   </local-definitions>
   <terms-and-conditions>
      <part name="rules-of-engagement">
         <title>Reglas de la evaluación</title>
         <p>Los auditores son independientes del proceso auditado. Las pruebas técnicas se acuerdan con el propietario del sistema y no deben afectar la operación. Los hallazgos se clasifican como no conformidad mayor, no conformidad menor, observación u oportunidad de mejora.</p>
      </part>
   </terms-and-conditions>
   <reviewed-controls>
      <description>
         <p>Se evalúan todos los controles del perfil Kudo.</p>
      </description>
      <control-selection>
         <include-all/>
      </control-selection>
   </reviewed-controls>
   <assessment-subject type="component">
      <description>
         <p>Todos los componentes del SSP.</p>
