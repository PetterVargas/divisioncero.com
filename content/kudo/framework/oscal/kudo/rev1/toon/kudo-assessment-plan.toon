"assessment-plan":
  uuid: fe943603-e363-57f4-beca-b0e79fd0d731
  metadata:
    title: Plan de Evaluación (AP) – Auditoría interna Kudo
    published: "2026-11-18T00:00:00Z"
    "last-modified": "2026-11-18T00:00:00Z"
    version: 0.1.0
    "oscal-version": 1.2.3
    remarks: "Programa de auditoría interna de referencia: evalúa los 36 controles Kudo, un dominio por mes, con revisión documental, entrevistas y pruebas técnicas, conforme al Procedimiento de Auditoría Interna del SGX. Ajusta fechas, alcance y auditores."
    links[1]{href,rel,"media-type",text}:
      "https://divisioncero.com/kudo/framework/oscal",canonical,text/html,Kudo y OSCAL
    roles[3]{id,title}:
      creator,Autor del contenido
      prepared-for,Organización destinataria
      assessor,Auditor interno
    parties[2]:
      - uuid: ed04377f-1282-41a6-b653-477f0b38742c
        type: organization
        name: DivisionCero
        links[1]{href,rel}:
          "https://divisioncero.com/kudo",homepage
      - uuid: e9de3acc-be4b-58c9-816f-25e260a9dcbe
        type: organization
        name: "[Nombre de tu organización]"
        remarks: Reemplaza este valor por la razón social de la organización que adopta Kudo.
    "responsible-parties"[2]:
      - "role-id": creator
        "party-uuids"[1]: ed04377f-1282-41a6-b653-477f0b38742c
      - "role-id": prepared-for
        "party-uuids"[1]: e9de3acc-be4b-58c9-816f-25e260a9dcbe
  "import-ssp":
    href: "#01974cd3-6aa5-5c1d-8131-808922726ef3"
  "local-definitions":
    activities[3]:
      - uuid: 88baad88-160c-5b7c-8eec-2f85aae8ed35
        title: Revisión documental
        description: "Revisar políticas, procedimientos, registros y configuraciones que evidencian el control."
        props[1]{name,value}:
          method,EXAMINE
        "related-controls":
          "control-selections"[1]:
            - "include-all":
      - uuid: af709827-56ca-57fa-83bf-875b48002241
        title: Entrevista
        description: Entrevistar a los responsables del control y a una muestra de usuarios.
        props[1]{name,value}:
          method,INTERVIEW
        "related-controls":
          "control-selections"[1]:
            - "include-all":
      - uuid: fd2c2ee4-dd6c-5435-9f4b-7105174742e7
        title: Prueba técnica
        description: Verificar el funcionamiento del control mediante pruebas o muestreo.
        props[1]{name,value}:
          method,TEST
        "related-controls":
          "control-selections"[1]:
            - "include-all":
  "terms-and-conditions":
    parts[1]{name,title,prose}:
      rules-of-engagement,Reglas de la evaluación,"Los auditores son independientes del proceso auditado. Las pruebas técnicas se acuerdan con el propietario del sistema y no deben afectar la operación. Los hallazgos se clasifican como no conformidad mayor, no conformidad menor, observación u oportunidad de mejora."
  "reviewed-controls":
    description: Se evalúan todos los controles del perfil Kudo.
    "control-selections"[1]:
      - "include-all":
  "assessment-subjects"[1]:
    - type: component
      description: Todos los componentes del SSP.
      "include-all":
