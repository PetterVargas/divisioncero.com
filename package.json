{
  "name": "kudo-new",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "type": "module",
  "scripts": {
    "build": "pnpm build:presentaciones && pnpm museo:update && pnpm build:next",
    "build:next": "pnpm static:generate && next build --webpack",
    "static:generate": "fumadocs-mdx && tsx --import ./scripts/register-mdx.ts ./scripts/og-generate.tsx && tsx --import ./scripts/register-mdx.ts ./scripts/search-generate.ts",
    "build:presentaciones": "pnpm --dir cyberacademy/presentaciones install --frozen-lockfile && PRESENTACIONES_OUT_DIR=../../public/cyberacademy/presentaciones pnpm --dir cyberacademy/presentaciones build",
    "dev": "next dev",
    "start": "next start",
    "preview": "pnpm run build && wrangler dev",
    "deploy": "pnpm run build && wrangler deploy",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "lint:links": "fumadocs-mdx && tsx --import ./scripts/register-mdx.ts ./scripts/lint.ts",
    "export:pdf": "fumadocs-mdx && tsx --import ./scripts/register-mdx.ts ./scripts/export-pdf.ts",
    "postinstall": "fumadocs-mdx",
    "openapi:generate": "tsx ./scripts/generate-openapi.ts",
    "museo:fetch": "tsx scripts/herramientas/museo-fetch.ts",
    "museo:process": "tsx scripts/herramientas/museo-process.ts",
    "museo:update": "pnpm run museo:fetch && pnpm run museo:process"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.9",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "feed": "^6.0.0",
    "fumadocs-core": "16.17.9",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-openapi": "12.5.5",
    "fumadocs-twoslash": "^4.0.4",
    "fumadocs-ui": "16.17.9",
    "gsap": "^3.15.0",
    "json-schema-typed": "^9.0.0",
    "jspdf": "^4.2.1",
    "katex": "^0.19.1",
    "lucide-react": "^1.65.0",
    "mermaid": "^12.2.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "next-validate-link": "^1.6.7",
    "qrcode": "^1.5.4",
    "radix-ui": "1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-force-graph-2d": "^1.29.2",
    "react-zoom-pan-pinch": "^4.2.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "1.4.0",
    "twoslash": "^0.3.9",
    "zbsearch": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^17.4.2",
    "postcss": "^8.5.32",
    "puppeteer": "^25.16.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "wrangler": "4.156.0"
  }
}
