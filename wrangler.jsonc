/**
 * Sitio estático: `pnpm build` genera `out/` y Cloudflare lo sirve como assets, sin código de
 * Worker (no hay invocaciones ni CPU por petición).
 * https://developers.cloudflare.com/workers/static-assets/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "divisioncero-com",
  "compatibility_date": "2025-04-02",
  "assets": {
    "directory": "out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  // Las ramas que no son `main` se despliegan con `wrangler preview`, que exige este bloque.
  "previews": {}
}
