"system-security-plan":
  uuid: a8228fef-0049-5088-9de4-3525e383ad73
  metadata:
    title: Plan de Seguridad del Sistema (SSP) – Plantilla Kudo
    published: "2026-11-18T00:00:00Z"
    "last-modified": "2026-11-18T00:00:00Z"
    version: 0.1.0
    "oscal-version": 1.2.3
    remarks: "SSP de referencia: describe un sistema genérico (\"Plataforma de la organización\") que adopta el perfil Kudo. Reemplaza los valores entre corchetes, documenta tus componentes técnicos y actualiza el estado de implementación de cada control (planned → partial → implemented)."
    links[1]{href,rel,"media-type",text}:
      "https://divisioncero.com/kudo/framework/oscal",canonical,text/html,Kudo y OSCAL
    roles[4]{id,title}:
      creator,Autor del contenido
      prepared-for,Organización destinataria
      system-owner,Propietario del sistema
      ciso,Responsable de Ciberseguridad
    parties[2]:
      - uuid: ed04377f-1282-41a6-b653-477f0b38742c
        type: organization
        name: DivisionCero
        links[1]{href,rel}:
          "https://divisioncero.com/kudo",homepage
      - uuid: e9de3acc-be4b-58c9-816f-25e260a9dcbe
        type: organization
        name: "[Nombre de tu organización]"
        remarks: Reemplaza este valor por la razón social de la organización que adopta Kudo.
    "responsible-parties"[2]:
      - "role-id": creator
        "party-uuids"[1]: ed04377f-1282-41a6-b653-477f0b38742c
      - "role-id": prepared-for
        "party-uuids"[1]: e9de3acc-be4b-58c9-816f-25e260a9dcbe
  "import-profile":
    href: "#242e1697-3681-58b1-900b-2954de79a7e0"
  "system-characteristics":
    "system-ids"[1]{"identifier-type",id}:
      "https://ietf.org/rfc/rfc4122",88b342b8-8fa8-5ee8-b527-2adf564cf2fc
    "system-name": "[Plataforma de la organización]"
    "system-name-short": SGX
    description: "Conjunto de procesos, personas y tecnología dentro del alcance del SGX de la organización: aplicaciones de negocio, infraestructura en la nube, puntos finales y proveedores críticos."
    "security-sensitivity-level": moderate
    "system-information":
      "information-types"[2]{uuid,title,description,"confidentiality-impact"{base},"integrity-impact"{base},"availability-impact"{base}}:
        cc0871a3-481c-5d7b-ae99-dbcd6947ddc4,Datos de clientes,Información de clientes y datos personales tratados por la plataforma (clasificación Confidencial).,moderate,moderate,moderate
        ea7a8c92-bcba-5f86-a087-e9ca6eb53ecf,Información interna de la organización,"Información financiera, contractual y operativa (clasificación Interna o Confidencial).",moderate,moderate,low
    "security-impact-level":
      "security-objective-confidentiality": moderate
      "security-objective-integrity": moderate
      "security-objective-availability": moderate
    status:
      state: operational
    "authorization-boundary":
      description: "[Describe el alcance del SGX: sedes, aplicaciones, cuentas de nube, procesos y proveedores incluidos, y las exclusiones justificadas.]"
  "system-implementation":
    users[2]:
      - uuid: ca514f8b-ed9c-5146-8a0d-5fe10dd27d59
